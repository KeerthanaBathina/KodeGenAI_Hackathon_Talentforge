{
  "name": "ai-interview-backend",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/startWorkers.ts",
    "worker:dev": "tsx watch src/startWorkers.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "load-test:db": "tsx scripts/load-test-db.ts",
    "load-test:indexes": "tsx scripts/load-test-indexes.ts",
    "load-test:audit": "tsx scripts/load-test-audit.ts",
    "load-test:audit-export": "tsx scripts/load-test-audit-export.ts",
    "analytics:pipeline:refresh": "tsx scripts/refresh-pipeline-kpi.ts",
    "analytics:pipeline:validate": "tsx scripts/validate-pipeline-kpi.ts",
    "analytics:pipeline:benchmark": "tsx scripts/benchmark-pipeline-kpi.ts",
    "analytics:funnel:validate": "tsx scripts/validate-funnel-stage.ts",
    "analytics:funnel:benchmark": "tsx scripts/benchmark-funnel-stage.ts",
    "analytics:confusion:validate": "tsx scripts/validate-confusion-matrix.ts",
    "analytics:confusion:benchmark": "tsx scripts/benchmark-confusion-matrix.ts",
    "benchmark:audit-latency": "tsx scripts/benchmark-audit-latency.ts",
    "validate:audit-retention-archive": "tsx scripts/validate-audit-retention-archive.ts",
    "validate:gdpr-anonymization": "tsx scripts/validate-gdpr-anonymization.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:diff": "prisma migrate diff --from-schema-datamodel prisma/schema.prisma --to-schema-datasource prisma/schema.prisma --exit-code --script",
    "rollback:pre": "tsx scripts/verify-rollback.ts pre",
    "rollback:post": "tsx scripts/verify-rollback.ts post",
    "zero-downtime:test": "tsx scripts/test-zero-downtime-migration.ts",
    "test:rls": "tsx scripts/test-rls.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:audit:unit": "vitest run src/queues/__tests__/auditEventQueue.test.ts src/workers/__tests__/auditEventWorker.test.ts src/workers/__tests__/weeklyAnalyticsDigestWorker.test.ts src/services/__tests__/auditService.test.ts src/services/__tests__/communicationService.test.ts",
    "test:audit:integration": "vitest run --config vitest.integration.config.ts src/routes/__tests__/audit-auth.integration.test.ts src/routes/__tests__/audit-decisions.integration.test.ts src/routes/__tests__/audit-config.integration.test.ts src/routes/__tests__/audit-communications.integration.test.ts src/routes/__tests__/audit-uploads.integration.test.ts src/routes/__tests__/audit-latency.guardrail.integration.test.ts src/services/__tests__/auditService.integration.test.ts src/db/__tests__/auditImmutability.integration.test.ts",
    "test:audit:regression": "npm run test:audit:unit && npm run test:audit:integration && npm run benchmark:audit-latency",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:preferences": "tsx prisma/seed-notification-preferences.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/client": "5.19.1",
    "@supabase/supabase-js": "2.54.0",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.35.6",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.81.2",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "4.21.2",
    "handlebars": "^4.7.9",
    "helmet": "8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.15.0",
    "pino": "9.3.2",
    "pino-http": "10.3.0",
    "puppeteer": "^25.4.0",
    "resend": "^6.18.0",
    "socket.io": "4.8.1",
    "uuid": "11.1.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "24.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.3.16",
    "@types/pdfkit": "^0.13.5",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "@vitest/coverage-v8": "2.0.5",
    "eslint": "8.57.0",
    "pino-pretty": "11.2.2",
    "prisma": "5.19.1",
    "rimraf": "6.0.1",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.1",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "2.0.5"
  }
}
