generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  candidate
  recruiter
  hr_reviewer
  hr_manager
  tech_interviewer
  admin
}

enum CandidateStatus {
  pending
  pending_verification
  active
  anonymized
}

enum OtpChallengePurpose {
  registration
}

enum RequisitionStatus {
  draft
  open
  closed
  filled
  cancelled
}

enum JobType {
  full_time
  part_time
  contract
  internship
}

enum ApplicationStatus {
  draft
  submitted
  screening
  pending_review
  shortlisted
  rejected
  withdrawn
  interviewing
  offer_pending
  offered
  hired
  closed
  pending_approval
  on_hold
}

enum ApplicationPath {
  fresher
  experienced
}

enum ResumeScanStatus {
  pending
  clean
  infected
}

enum ScreeningRecommendation {
  shortlist
  manual_review
  reject
}

enum ReviewDecision {
  shortlisted
  rejected
  hold
}

enum AssessmentType {
  aptitude
  coding
  technical
}

enum AssessmentSessionStatus {
  in_progress
  completed
  expired
  launch_failed
}

enum InterviewStageType {
  aptitude
  coding
  technical
  system_design
  cultural
  hr
}

enum InterviewStageState {
  scheduled
  completed
  cancelled
  no_show
  rescheduled
}

enum ScorecardRecommendation {
  strong_yes
  yes
  no
  strong_no
}

enum DecisionOutcome {
  offer
  reject
  hold
  withdraw
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum CommunicationChannel {
  email
  sms
}

enum CommunicationStatus {
  queued
  sent
  delivered
  bounced
  failed
}

enum TemplateType {
  offer
  rejection
  screening_invite
  interview_invite
  assessment_invite
  withdrawal_ack
  general
  user_onboarding
}

enum ReasonCodeCategory {
  rejection
  withdrawal
  interview_cancellation
  decision
  offer_decision
  reject_decision
  hold_decision
  withdraw_decision
}

enum OnboardingSection {
  basic_info
  skills
  education
  work_history
  privacy_consent
}

enum OfferStatus {
  pending
  accepted
  declined
  expired
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationTypeEnum {
  APPLICATION_SUBMITTED
  REVIEW_ASSIGNED
  DECISION_MADE
  INTERVIEW_SCHEDULED
  SCORECARD_SUBMITTED
  OFFER_APPROVED
  OFFER_EXTENDED
  SLA_WARNING
  PATH_OVERRIDE_REQUESTED
}

model User {
  id                        String                 @id @default(uuid()) @db.Uuid
  email                     String                 @unique @db.VarChar(255)
  role                      UserRole
  fullName                  String                 @db.VarChar(255)
  timezone                  String                 @default("UTC") @db.VarChar(50)
  active                    Boolean                @default(true)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  credential                UserCredential?
  profileEdits              Profile[]              @relation("ProfileEditor")
  pathOverrideApprovals     Application[]          @relation("PathOverrideApprover")
  reviews                   Review[]               @relation("Reviewer")
  interviewScorecards       InterviewScorecard[]   @relation("Interviewer")
  decisions                 Decision[]             @relation("DecisionMaker")
  approvals                 Approval[]             @relation("Approver")
  panelAvailability         PanelAvailability[]
  jobFamiliesCreated        JobFamily[]            @relation("JobFamilyCreator")
  scoringThresholdsAuthored ScoringThreshold[]     @relation("ThresholdAuthor")
  screeningThresholdsAuthored ScreeningThreshold[] @relation("ScreeningThresholdAuthor")
  approvalPoliciesAuthored  ApprovalPolicy[]       @relation("ApprovalPolicyAuthor")
  auditEvents               AuditEvent[]           @relation("AuditActor")
  panelistConfirmations     PanelistConfirmation[] @relation("PanelistConfirmations")
  assignedTasks             Task[]                 @relation("TaskAssignee")
  templateVersionsAuthored  TemplateVersion[]      @relation("TemplateVersionAuthor")
  notifications             Notification[]         @relation("UserNotifications")
  notificationPreferences   NotificationPreference[] @relation("UserNotificationPreferences")

  @@map("users")
}

model UserCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model PanelAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  weekday   Int
  startHour Int
  endHour   Int
  timezone  String   @default("UTC") @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday, active], name: "idx_panel_availability_user_weekday")
  @@map("panel_availability")
}

model Candidate {
  id                String          @id @default(uuid()) @db.Uuid
  email             String          @unique @db.VarChar(255)
  phone             String?         @unique @db.VarChar(50)
  timezone          String          @default("UTC") @db.VarChar(50)
  consentVersion    String          @default("1.0") @db.VarChar(20)
  consentTimestamp  DateTime        @default(now())
  status            CandidateStatus @default(pending_verification)
  candidatePublicId String?         @unique @db.VarChar(64)

  // Account Security & Lockout
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAttemptAt    DateTime?
  lastSuccessfulLoginAt DateTime?

  // Interview No-Show Tracking
  noShowCount Int @default(0)

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  profile             Profile?
  applications        Application[]
  credential          CandidateCredential?
  otpChallenges       CandidateOtpChallenge[]
  passwordResetTokens PasswordResetToken[]
  privacyConsents     PrivacyConsent[]

  @@index([email, lockedUntil], name: "idx_candidate_lockout_check")
  @@map("candidates")
}

model CandidateCredential {
  candidateId  String    @id @db.Uuid
  passwordHash String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_credentials")
}

model CandidateOtpChallenge {
  id          String              @id @default(uuid()) @db.Uuid
  candidateId String              @db.Uuid
  purpose     OtpChallengePurpose @default(registration)
  otpHash     String              @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())
  candidate   Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, purpose, createdAt(sort: Desc)], name: "idx_candidate_otp_challenge_lookup")
  @@index([expiresAt], name: "idx_candidate_otp_expires_at")
  @@map("candidate_otp_challenges")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @db.Uuid
  token       String    @unique @db.VarChar(255)
  expiresAt   DateTime
  usedAt      DateTime?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.Text
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, expiresAt], name: "idx_password_reset_candidate_expiry")
  @@index([expiresAt], name: "idx_password_reset_expiry")
  @@map("password_reset_tokens")
}

model PrivacyConsent {
  id            String    @id @default(uuid()) @db.Uuid
  candidateId   String    @db.Uuid
  policyVersion String    @db.VarChar(20)
  acceptedAt    DateTime  @default(now())
  ipAddress     String    @db.VarChar(45)
  userAgent     String?   @db.Text
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, policyVersion], name: "idx_privacy_consent_candidate_version")
  @@index([acceptedAt], name: "idx_privacy_consent_accepted")
  @@map("privacy_consents")
}

model Profile {
  id                          String             @id @default(uuid()) @db.Uuid
  candidateId                 String             @unique @db.Uuid
  fullName                    String             @db.VarChar(255)
  experienceYears             Int
  skills                      String[]           @db.Text
  education                   Json               @db.JsonB
  workHistory                 Json?              @db.JsonB
  profileCompletionPercentage Int                @default(0)
  lastCompletedSection        OnboardingSection?
  rawParseJson                Json               @db.JsonB
  editedById                  String?            @db.Uuid
  editedAt                    DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  candidate                   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  editedBy                    User?              @relation("ProfileEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model JobFamily {
  id                       String             @id @default(uuid()) @db.Uuid
  name                     String             @db.VarChar(255)
  thresholdVersion         Int                @default(1)
  matchScoreThreshold      Int
  confidenceThreshold      Decimal            @db.Decimal(5, 4)
  experienceThresholdYears Int
  effectiveFrom            DateTime
  createdById              String             @db.Uuid
  createdAt                DateTime           @default(now())
  createdBy                User               @relation("JobFamilyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  requisitions             Requisition[]
  scoringThresholds        ScoringThreshold[]

  @@map("job_families")
}

model ReasonCode {
  id              String             @id @default(uuid()) @db.Uuid
  category        ReasonCodeCategory
  code            String             @db.VarChar(50)
  displayText     String             @db.VarChar(255)
  description     String?            @db.Text
  displayOrder    Int                @default(0)
  active          Boolean            @default(true)
  reviews         Review[]
  decisions       Decision[]
  interviewStages InterviewStage[]

  @@unique([category, code])
  @@index([category, displayOrder])
  @@map("reason_codes")
}

model Template {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(255)
  type           TemplateType
  locale         String            @db.VarChar(10)
  version        Int               @default(1)
  subject        String            @db.VarChar(500)
  bodyHtml       String            @db.Text
  bodyText       String            @db.Text
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  communications Communication[]
  versions       TemplateVersion[]

  @@unique([type, locale, version])
  @@map("templates")
}

model TemplateVersion {
  id            String       @id @default(uuid()) @db.Uuid
  templateId    String       @db.Uuid
  versionNumber Int
  name          String       @db.VarChar(255)
  type          TemplateType
  locale        String       @db.VarChar(10)
  subject       String       @db.VarChar(500)
  bodyHtml      String       @db.Text
  bodyText      String       @db.Text
  createdById   String       @db.Uuid
  createdAt     DateTime     @default(now()) @db.Timestamptz

  template  Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User     @relation("TemplateVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([templateId, versionNumber])
  @@index([templateId, createdAt(sort: Desc)])
  @@map("template_versions")
}

model ApprovalPolicy {
  id                  String        @id @default(uuid()) @db.Uuid
  compensationBandMin Decimal       @db.Decimal(12, 2)
  compensationBandMax Decimal       @db.Decimal(12, 2)
  requiredApprovers   Json          @db.JsonB
  active              Boolean       @default(true)
  effectiveFrom       DateTime      @default(dbgenerated("'1970-01-01 00:00:00+00'::timestamp with time zone")) @db.Timestamptz
  createdById         String?       @db.Uuid
  createdAt           DateTime      @default(now())
  
  createdBy           User?         @relation("ApprovalPolicyAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  applications        Application[]

  @@index([compensationBandMin, compensationBandMax, effectiveFrom(sort: Desc)], name: "idx_approval_policies_band_effective")
  @@map("approval_policies")
}

model ScoringThreshold {
  id                       String        @id @default(uuid()) @db.Uuid
  jobFamilyId              String        @db.Uuid
  aiShortlistThreshold     Decimal       @db.Decimal(5, 4)
  confidenceThreshold      Decimal       @db.Decimal(5, 4)
  experienceThresholdYears Int
  effectiveFrom            DateTime      @db.Timestamptz
  createdById              String        @db.Uuid
  createdAt                DateTime      @default(now()) @db.Timestamptz
  
  jobFamily                JobFamily     @relation(fields: [jobFamilyId], references: [id], onDelete: Restrict)
  createdBy                User          @relation("ThresholdAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  applications             Application[]

  @@index([jobFamilyId, effectiveFrom(sort: Desc)], name: "idx_scoring_thresholds_jf_effective")
  @@map("scoring_thresholds")
}

model ScreeningThreshold {
  id                 String        @id @default(uuid()) @db.Uuid
  shortlistThreshold Int
  borderlineMin      Int
  borderlineMax      Int
  rejectThreshold    Int
  version            Int           @default(1)
  effectiveFrom      DateTime      @default(now()) @db.Timestamptz
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz
  
  createdBy          User?         @relation("ScreeningThresholdAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  applications       Application[]

  @@index([effectiveFrom(sort: Desc)], name: "idx_screening_thresholds_effective")
  @@index([createdById], name: "idx_screening_threshold_creator")
  @@map("screening_thresholds")
}

model Requisition {
  id                  String            @id @default(uuid()) @db.Uuid
  title               String            @db.VarChar(255)
  department          String            @db.VarChar(100)
  jobFamilyId         String            @db.Uuid
  location            String            @db.VarChar(255)
  jobType             JobType
  slots               Int
  filledSlots         Int               @default(0)
  status              RequisitionStatus @default(draft)
  eligibilityCriteria Json              @db.JsonB
  requiredSkills      String[]          @default([])
  preferredSkills     String[]          @default([])
  minExperienceYears  Int               @default(0)
  educationLevel      String?
  openedAt            DateTime?
  closedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  jobFamily           JobFamily         @relation(fields: [jobFamilyId], references: [id], onDelete: Restrict)
  applications        Application[]

  @@index([status], name: "idx_requisitions_status")
  @@index([department], name: "idx_requisitions_department")
  @@index([location], name: "idx_requisitions_location")
  @@index([jobType], name: "idx_requisitions_job_type")
  @@index([status, openedAt(sort: Desc), createdAt(sort: Desc)], name: "idx_requisitions_status_opened_created")
  @@map("requisitions")
}

model Application {
  id                        String              @id @default(uuid()) @db.Uuid
  candidateId               String              @db.Uuid
  requisitionId             String              @db.Uuid
  status                    ApplicationStatus   @default(submitted)
  manualReviewReason        String?             @db.VarChar(100)
  path                      ApplicationPath?
  pathOverridden            Boolean             @default(false)
  pathOverrideJustification String?             @db.Text
  pathOverrideApproverId    String?             @db.Uuid
  draftData                 Json?               @db.JsonB
  draftSavedAt              DateTime?
  submittedAt               DateTime            @default(now())
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  
  // Policy version tracking for in-flight isolation
  screeningThresholdId      String?             @db.Uuid
  scoringThresholdId        String?             @db.Uuid
  approvalPolicyId          String?             @db.Uuid
  
  candidate                 Candidate           @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  requisition               Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  pathOverrideApprover      User?               @relation("PathOverrideApprover", fields: [pathOverrideApproverId], references: [id], onDelete: SetNull)
  screeningThreshold        ScreeningThreshold? @relation(fields: [screeningThresholdId], references: [id], onDelete: SetNull)
  scoringThreshold          ScoringThreshold?   @relation(fields: [scoringThresholdId], references: [id], onDelete: SetNull)
  approvalPolicy            ApprovalPolicy?     @relation(fields: [approvalPolicyId], references: [id], onDelete: SetNull)
  resume                    Resume?
  screenings                Screening[]
  reviews                   Review[]
  assessments               Assessment[]
  assessmentSessions        AssessmentSession[]
  interviewStages           InterviewStage[]
  decision                  Decision?
  communications            Communication[]
  offers                    Offer[]

  @@unique([candidateId, requisitionId, status], name: "unique_candidate_requisition_draft")
  @@index([requisitionId, status], name: "idx_applications_requisition_status")
  @@index([candidateId, status], name: "idx_applications_candidate_status")
  @@index([status, submittedAt(sort: Desc)], name: "idx_applications_status_submitted_at")
  @@index([candidateId, requisitionId, status], name: "idx_applications_candidate_req_status")
  @@index([screeningThresholdId], name: "idx_application_screening_threshold")
  @@index([scoringThresholdId], name: "idx_application_scoring_threshold")
  @@index([approvalPolicyId], name: "idx_application_approval_policy")
  @@map("applications")
}

model Resume {
  id            String           @id @default(uuid()) @db.Uuid
  applicationId String           @unique @db.Uuid
  storageKey    String           @db.Uuid
  fileName      String           @db.VarChar(255)
  fileSize      Int
  mimeType      String           @db.VarChar(100)
  scanStatus    ResumeScanStatus @default(pending)
  scanResult    Json?            @db.JsonB
  parsedData    Json?            @db.JsonB
  uploadedAt    DateTime         @default(now())
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model Screening {
  id               String                   @id @default(uuid()) @db.Uuid
  applicationId    String                   @db.Uuid
  score            Int
  recommendation   ScreeningRecommendation?
  factors          Json                     @db.JsonB
  thresholdVersion Int?
  screenedAt       DateTime                 @default(now())
  modelVersion     String?                  @db.VarChar(50)
  confidence       Decimal?                 @db.Decimal(5, 4)
  evaluatedAt      DateTime                 @default(now())
  version          Int                      @default(1)
  application      Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, version(sort: Desc)], name: "idx_screenings_application_version")
  @@index([recommendation], name: "idx_screenings_recommendation")
  @@index([screenedAt(sort: Desc)], name: "idx_screenings_screened_at")
  @@map("screenings")
}

model Review {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @db.Uuid
  reviewerId    String         @db.Uuid
  decision      ReviewDecision
  reasonCodeId  String?        @db.Uuid
  notes         String?        @db.Text
  decidedAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer      User           @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reasonCode    ReasonCode?    @relation(fields: [reasonCodeId], references: [id], onDelete: Restrict)

  @@index([applicationId, decidedAt(sort: Desc)], name: "idx_reviews_application_decided_at")
  @@map("reviews")
}

model Assessment {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @db.Uuid
  type          AssessmentType
  providerRef   String         @db.VarChar(255)
  score         Decimal?       @db.Decimal(6, 2)
  metadata      Json?          @db.JsonB
  startedAt     DateTime?
  completedAt   DateTime?
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

enum PanelistConfirmationStatus {
  pending
  confirmed
  declined
}

enum ScorecardStatus {
  draft
  submitted
}

enum InterviewRecommendation {
  advance
  hold
  reject
}

model InterviewStage {
  id                    String                 @id @default(uuid()) @db.Uuid
  applicationId         String                 @db.Uuid
  type                  InterviewStageType
  scheduledAt           DateTime?
  endAt                 DateTime?
  timezone              String                 @db.VarChar(50)
  panelMembers          String[]               @db.Uuid
  state                 InterviewStageState    @default(scheduled)
  reasonCodeId          String?                @db.Uuid
  cancelReason          String?                @db.Text
  rescheduledFromId     String?                @unique @db.Uuid
  rescheduledToId       String?                @unique @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  application           Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reasonCode            ReasonCode?            @relation(fields: [reasonCodeId], references: [id], onDelete: SetNull)
  rescheduledFrom       InterviewStage?        @relation("RescheduledFrom", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo         InterviewStage?        @relation("RescheduledTo", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFromThis   InterviewStage?        @relation("RescheduledFrom")
  rescheduledToThis     InterviewStage?        @relation("RescheduledTo")
  interviewScorecards   InterviewScorecard[]
  panelistConfirmations PanelistConfirmation[]

  @@index([applicationId, type], name: "idx_interview_stages_application_type")
  @@map("interview_stages")
}

model PanelistConfirmation {
  id                 String                     @id @default(uuid()) @db.Uuid
  interviewStageId   String                     @db.Uuid
  panelistId         String                     @db.Uuid
  status             PanelistConfirmationStatus @default(pending)
  tokenHash          String?                    @unique @db.VarChar(255)
  confirmationSentAt DateTime?
  respondedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  interviewStage     InterviewStage             @relation(fields: [interviewStageId], references: [id], onDelete: Cascade)
  panelist           User                       @relation("PanelistConfirmations", fields: [panelistId], references: [id], onDelete: Cascade)

  @@unique([interviewStageId, panelistId])
  @@index([interviewStageId], name: "idx_panelist_confirmations_interview")
  @@index([panelistId, status], name: "idx_panelist_confirmations_panelist")
  @@index([tokenHash], name: "idx_panelist_confirmations_token")
  @@map("panelist_confirmations")
}

model InterviewScorecard {
  id               String                   @id @default(cuid())
  interviewStageId String                   @db.Uuid
  interviewerId    String                   @db.Uuid
  status           ScorecardStatus          @default(draft)
  recommendation   InterviewRecommendation?
  aggregateScore   Decimal?                 @db.Decimal(3, 1)
  submittedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  interviewStage   InterviewStage           @relation(fields: [interviewStageId], references: [id], onDelete: Cascade)
  interviewer      User                     @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: Restrict)
  dimensions       ScorecardDimension[]

  @@unique([interviewStageId, interviewerId])
  @@index([interviewStageId], name: "idx_scorecards_interview_stage")
  @@index([interviewerId, status], name: "idx_scorecards_interviewer_status")
  @@map("interview_scorecards")
}

model ScorecardDimension {
  id            String             @id @default(cuid())
  scorecardId   String
  dimensionName String             @db.VarChar(100)
  score         Int?
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  scorecard     InterviewScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, dimensionName])
  @@index([scorecardId], name: "idx_scorecard_dimensions_scorecard")
  @@map("scorecard_dimensions")
}

model RubricTemplate {
  id            String   @id @default(cuid())
  stageType     String   @db.VarChar(50)
  dimensionName String   @db.VarChar(100)
  displayOrder  Int
  description   String   @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([stageType, dimensionName])
  @@index([stageType, isActive, displayOrder], name: "idx_rubric_templates_lookup")
  @@map("rubric_templates")
}

model Decision {
  id               String          @id @default(uuid()) @db.Uuid
  applicationId    String          @unique @db.Uuid
  outcome          DecisionOutcome
  reasonCodeId     String?         @db.Uuid
  compensationBand String?         @db.VarChar(50)
  offerDetails     Json?           @db.JsonB
  pdfUrl           String?         @db.Text
  decidedById      String          @db.Uuid
  decidedAt        DateTime        @default(now())
  application      Application     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reasonCode       ReasonCode?     @relation(fields: [reasonCodeId], references: [id], onDelete: Restrict)
  decidedBy        User            @relation("DecisionMaker", fields: [decidedById], references: [id], onDelete: Restrict)
  approvals        Approval[]
  offer            Offer?

  @@map("decisions")
}

model Approval {
  id          String         @id @default(uuid()) @db.Uuid
  decisionId  String         @db.Uuid
  approverId  String         @db.Uuid
  tier        String         @db.VarChar(50)
  status      ApprovalStatus @default(pending)
  comments    String?        @db.Text
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  decision    Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  approver    User           @relation("Approver", fields: [approverId], references: [id], onDelete: Restrict)

  @@map("approvals")
}

model Offer {
  id             String      @id @default(uuid()) @db.Uuid
  decisionId     String      @unique @db.Uuid
  applicationId  String      @db.Uuid
  pdfUrl         String?     @db.Text
  pdfStoragePath String?     @db.Text
  status         OfferStatus @default(pending)
  expiresAt      DateTime
  respondedAt    DateTime?
  responseReason String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  decision       Decision    @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([applicationId])
  @@map("offers")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  assignedTo  String    @db.Uuid
  title       String    @db.Text
  description String?   @db.Text
  dueDate     DateTime  @map("due_date")
  status      String    @default("pending") @db.VarChar(20)
  priority    String    @default("normal") @db.VarChar(10)
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String    @map("entity_id") @db.Uuid
  metadata    Json      @default("{}") @db.JsonB
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  assignee    User      @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: Restrict)

  @@index([assignedTo, status], name: "idx_tasks_assigned_to_status")
  @@index([dueDate], name: "idx_tasks_due_date")
  @@index([entityType, entityId], name: "idx_tasks_entity")
  @@map("tasks")
}

model Communication {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @db.Uuid
  templateId    String               @db.Uuid
  channel       CommunicationChannel
  providerName  String               @db.VarChar(50)
  messageId     String?              @db.VarChar(255)
  status        CommunicationStatus  @default(queued)
  retryCount    Int                  @default(0)
  sentAt        DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime             @default(now())
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  template      Template             @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([applicationId, status], name: "idx_communications_application_status")
  @@map("communications")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  eventType String    @db.VarChar(100)
  payload   Json      @db.JsonB
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt], name: "notification_user_read_idx")
  @@index([userId, createdAt(sort: Desc)], name: "notification_user_created_idx")
  @@map("notifications")
}

model NotificationPreference {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  user             User                   @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
  notificationType NotificationTypeEnum
  channel          NotificationChannel
  enabled          Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([userId, notificationType, channel], name: "user_notification_channel_unique")
  @@index([userId], name: "notification_pref_user_idx")
  @@map("notification_preferences")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  eventType   String   @db.VarChar(100)
  entityType  String   @db.VarChar(50)
  entityId    String   @db.Uuid
  payloadJson Json     @db.JsonB
  ipAddress   String?  @db.Inet
  userAgent   String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @db.Timestamptz
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)], name: "idx_audit_events_entity")
  @@index([actorId, createdAt(sort: Desc)], name: "idx_audit_events_actor")
  @@map("audit_events")
}

model AssessmentProvider {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(255)
  apiEndpoint        String              @db.VarChar(500)
  authMode           String              @db.VarChar(50)
  hmacSecret         String?             @db.VarChar(255)
  timeoutSeconds     Int                 @default(30)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assessmentSessions AssessmentSession[]

  @@index([active], name: "idx_assessment_providers_active")
  @@map("assessment_providers")
}

model AssessmentSession {
  id            String                  @id @default(uuid()) @db.Uuid
  applicationId String                  @db.Uuid
  providerId    String                  @db.Uuid
  sessionToken  String                  @db.VarChar(500)
  testUrl       String                  @db.VarChar(1000)
  status        AssessmentSessionStatus @default(in_progress)
  launchedAt    DateTime                @default(now())
  completedAt   DateTime?
  score         Decimal?                @db.Decimal(6, 2)
  metadata      Json?                   @db.JsonB
  application   Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider      AssessmentProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([applicationId, status], name: "idx_assessment_sessions_application_status")
  @@index([sessionToken], name: "idx_assessment_sessions_session_token")
  @@map("assessment_sessions")
}
