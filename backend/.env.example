NODE_ENV=development
PORT=3001

# Database - Supabase PgBouncer connection pooler (transaction mode)
# Used by Prisma Client for all application queries
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30

# Database - Supabase direct connection (session mode)
# Used by Prisma Migrate only
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Upstash Redis - REST API. Select the closest region for latency under 50ms.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_ANON_KEY=replace-me
FRONTEND_URL=http://localhost:3000
OTP_HASH_SALT=replace-with-long-random-secret
OTP_EXPIRY_MINUTES=15
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@your-domain.com
# Example: smtp.gmail.com / smtp.office365.com / smtp.sendgrid.net
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SECURE=false

# RLS validation accounts (test-only)
TEST_CANDIDATE_1_EMAIL=candidate-a@example.com
TEST_CANDIDATE_1_PASSWORD=replace-me
TEST_CANDIDATE_1_ID=00000000-0000-0000-0000-000000000001
TEST_CANDIDATE_2_EMAIL=candidate-b@example.com
TEST_CANDIDATE_2_PASSWORD=replace-me
TEST_CANDIDATE_2_ID=00000000-0000-0000-0000-000000000002

# Resume parsing configuration
ENABLE_LOCAL_RESUME_PROCESSING=true

# Resume parser service endpoint examples
# Use Docker service DNS when backend and parser run in the same Docker network:
# RESUME_PARSER_ENDPOINT=http://resume-intake-api:8000/parse
# Use localhost when backend runs on host machine:
# RESUME_PARSER_ENDPOINT=http://localhost:8000/parse
RESUME_PARSER_ENDPOINT=
RESUME_PARSER_API_KEY=
RESUME_PARSER_TIMEOUT_MS=30000

# GDPR and Retention Configuration
GDPR_ANONYMIZATION_SLA_DAYS=30
AUDIT_RETENTION_YEARS=7
AUDIT_ARCHIVE_BUCKET=local-audit-archive
AUDIT_ARCHIVE_PATH_PREFIX=audit-events
AUDIT_ARCHIVE_BATCH_SIZE=5000
AUDIT_ARCHIVE_CHUNK_SIZE=1000

# OpenTelemetry - Grafana Cloud OTLP
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-your-stack.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-instanceid-token
OTEL_SERVICE_NAME=ai-interview-backend
